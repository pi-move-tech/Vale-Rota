<%- include ('partials/header.ejs', { titulo: 'Notificações', voltar: '/perfil' }) %>

<form action="/perfil/notificacoes" method="POST">
    <div class="cartao form-check form-switch d-flex justify-content-between align-items-center ps-3">
        <label for="notificacoes" class="mb-0">Receber notificações de alertas</label>
        <input class="form-check-input" type="checkbox" role="switch" name="notificacoes" id="notificacoes" <%= ativas ? 'checked' : '' %>>
    </div>
    <button type="submit" class="btn btn-vale w-100">SALVAR</button>
</form>

<%- include ('partials/footer.ejs', { ativo: 'perfil' }) %>
