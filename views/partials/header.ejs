<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/style.css">
    <title>Vale Rota</title>
</head>
<body>
<div id="app">
    <% if (locals.titulo) { %>
    <header class="topbar">
        <% if (locals.voltar) { %><a class="voltar" href="<%= voltar %>">&larr;</a><% } %>
        <% if (locals.saudacao) { %>
            <div><small>Olá, <%= usuario.nome %>!</small><strong><%= titulo %></strong></div>
        <% } else { %>
            <span><%= titulo %></span>
        <% } %>
    </header>
    <% } else { %>
    <div class="topbar topbar-vazia"></div>
    <% } %>
    <main class="conteudo">
        <% if (locals.msg) { %><div class="alert alert-success py-2"><%= msg %></div><% } %>
        <% if (locals.erro) { %><div class="alert alert-danger py-2"><%= erro %></div><% } %>
