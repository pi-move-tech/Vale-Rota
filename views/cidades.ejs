<%- include ('partials/header.ejs', { titulo: 'Cidades de interesse', voltar: '/perfil' }) %>

<form action="/perfil/cidades" method="POST">
    <% cidades.forEach(c => { %>
        <label class="cartao d-flex justify-content-between align-items-center mb-2" for="c<%= c.id %>">
            <%= c.nome %>
            <input type="checkbox" class="form-check-input" name="cidades" value="<%= c.id %>" id="c<%= c.id %>" <%= minhas.includes(c.id) ? 'checked' : '' %>>
        </label>
    <% }) %>
    <button type="submit" class="btn btn-vale w-100 mt-3">SALVAR</button>
</form>

<%- include ('partials/footer.ejs', { ativo: 'perfil' }) %>
